{
  "manifest_version": 3,
  "name": "CanYouSleep",
  "version": "1.0.0",
  "description": "Smart attendance analytics, recovery estimates, and date-range simulator for PW Institute of Innovation.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CanYouSleep",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.pwioi.club/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://app.pwioi.club/*",
    "https://api.pwioi.club/*"
  ]
}
